{
  "name": "night-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "simulator:dev": "node pos-simulator/server.mjs",
    "simulator:market": "node pos-simulator/market-runner.mjs",
    "simulator:verify": "vitest run tests/integration",
    "simulator:reset": "node scripts/reset-demo-service.mjs",
    "simulator:verify-live": "node scripts/verify-live-pos-flow.mjs",
    "setup:env": "node scripts/create-local-env.mjs",
    "launch:readiness": "node scripts/check-launch-readiness.mjs",
    "build": "tsc -b && vite build",
    "build:production": "npm run runtime:verify && npm run check:env && npm run build",
    "cloudflare:config": "node scripts/verify-cloudflare-pages.mjs",
    "check:env": "node scripts/validate-env.mjs",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "source:verify": "node scripts/verify-source-graph.mjs",
    "supabase:sql": "node scripts/print-supabase-sql.mjs",
    "supabase:grant-operator": "node scripts/print-operator-grant-sql.mjs",
    "supabase:create-operator": "node scripts/create-venue-operator.mjs",
    "supabase:prepare-test-service": "node scripts/prepare-venue-test-service.mjs",
    "supabase:verify-operator": "node scripts/verify-venue-operator.mjs",
    "supabase:smoke-live": "node scripts/smoke-supabase-live.mjs",
    "supabase:verify-cloud-sync": "node scripts/verify-cloud-sync.mjs",
    "supabase:verify-smoke": "node scripts/verify-live-smoke-script.mjs",
    "supabase:verify-sql": "node scripts/verify-supabase-sql.mjs",
    "supabase:status": "node scripts/check-supabase-setup.mjs",
    "supabase:functions": "node scripts/verify-supabase-functions.mjs",
    "pricing:sync": "node scripts/verify-pricing-engine-sync.mjs",
    "preview": "vite preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check": "npm run runtime:verify && npm run source:verify && npm run lint && npm run test:all && npm run cloudflare:config && npm run supabase:verify-sql && npm run supabase:functions && npm run supabase:verify-smoke && npm run pricing:sync && npm run smoke:preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "vitest": "^4.1.9"
  }
}
